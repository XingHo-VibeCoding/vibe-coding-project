# ===== 环境变量模板（.env.example）=====
#
# 用法：复制成 .env（或把值填进 cloudbaserc.json 的 envVariables），再把 <…> 换成自己的真值。
#   .env            会被 .gitignore 忽略，永远不进仓库、不进提交
#   .env.example    只有占位符，必须进仓库 —— 它是「需要配哪几个变量」的清单
#
# 本项目的云函数（cloudfunctions/list、cloudfunctions/write）在 CloudBase 上运行时
# 从「函数环境变量」读取下面这些值；本地调试时从 .env 读。两边名字必须完全一致。

# ── 云函数：读库凭据（list / write 共用同一把钥匙）────────────────
# 环境 ID，形如 vibecoding-test-d5fqmhbb955e19dd。
# 云函数运行时自带 TCB_ENV，通常可以不配；本地调试必须显式给。
TCB_ENV_ID=<你的 CloudBase 环境 ID>

# 服务端 API Key（service_role 级）。控制台「环境管理 → HTTP 网关 → API Key 配置」创建。
# ⚠ 这把钥匙等于管理员权限，泄漏 = 数据库门大开。只放环境变量，不写代码、不返回前端。
CLOUDBASE_API_KEY=<CloudBase 服务端 API Key>

# ── 云函数 write：写接口口令 ──────────────────────────────────
# 调用 POST/PUT/DELETE 时要带 X-Write-Token 头（或 ?token= 查询参数）。
# 没配 = 一律拒绝（fail-closed），不存在「没配就放行」。
WRITE_TOKEN=<自己定一个写口令，别提交真实值>

# ── 后端自测脚本用（.workbuddy/tmp/ 下的脚本，不入库）────────────
# 公网网关地址，形如 https://<envId>-<随机后缀>.ap-shanghai.app.tcloudbase.com
API_BASE=<你的 HTTP 访问服务默认域名>
